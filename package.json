{
  "name": "chatfat",
  "version": "2.0.0",
  "private": true,
  "description": "Real-time group chat on raw WebSockets, with end-to-end encrypted rooms.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/protocol.js",
    "test:auth": "node test/auth.js",
    "test:persistence": "node test/persistence.js",
    "test:crypto": "node test/crypto.js",
    "test:atrest": "node test/atrest.js",
    "test:signing": "node test/signing.js",
    "test:pg": "node test/postgres.js",
    "test:all": "node test/protocol.js && node test/auth.js && node test/persistence.js && node test/crypto.js && node test/atrest.js && node test/signing.js && node test/postgres.js",
    "loadtest": "node tools/loadtest.js",
    "tamper": "node tools/tamper.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.29",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "pg": "^8.13.0"
  }
}
